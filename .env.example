POSTGRES_DB=epr_portal
POSTGRES_USER=epr
POSTGRES_PASSWORD=epr_dev_password
DATABASE_URL=postgresql+psycopg://epr:epr_dev_password@localhost:5432/epr_portal
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
VITE_API_BASE_URL=http://localhost:8000/api
VITE_ADMIN_URL=http://localhost:5174
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5-mini
OPENAI_OCR_MODEL=gpt-5-mini
# local: 本地 CPU 识别，不需要 API Key；openai: 显式启用云端识别
OCR_PROVIDER=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EPR Portal
SMTP_USE_TLS=true
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
VERIFICATION_CODE_EXPIRE_MINUTES=10
VERIFICATION_CODE_RESEND_SECONDS=60
VERIFICATION_CODE_MAX_ATTEMPTS=5
# 仅限本地开发：开启后发送验证码接口会在响应中返回验证码
VERIFICATION_DEBUG=false
PORTAL_URL=http://localhost:5173
ADMIN_PORTAL_URL=http://localhost:5174
